# Legal Data Factory Environment Configuration
# Copy this file to .env.local and fill in your values

# Neon Postgres Database URL
# Get this from your Neon dashboard: https://console.neon.tech
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# GitHub Personal Access Token (for issue management)
# Create at: https://github.com/settings/tokens
# Required scopes: repo, write:org (for projects)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub repository for issue tracking
GITHUB_REPO=your-username/legal-data-factory

# EUR-Lex API Key (optional, for higher rate limits)
# Register at: https://eur-lex.europa.eu/content/help/data-reuse/data-reuse.html
EURLEX_API_KEY=

# Légifrance PISTE API credentials (optional, for France)
# Register at: https://piste.gouv.fr
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=

# Logging
LOG_LEVEL=INFO
